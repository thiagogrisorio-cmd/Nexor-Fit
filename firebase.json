{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Nexor-Fit",
        "supportEmail": "thiagogrisorio@gmail.com"
      }
    },
    "authorizedDomains": [
      "nexor-fit-app.firebaseapp.com",
      "nexor-fit-app.web.app",
      "thiagogrisorio-cmd.github.io",
      "localhost"
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    }
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log"
    ]
  }
}
