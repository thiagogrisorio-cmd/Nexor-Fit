// users/{uid}/workouts/{0..3}: session string 1..64, logged bool,
// exercises: exactly 12 {done bool, weight string <=16, empty or 0..2000 kg},
// updatedAt: server timestamp. All fields required; uid determined by path.
// users/{uid}/history/{session}: day int 0..3, at timestamp, immutable.
// History is self-reported; historical timestamps support explicit import.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function validExercise(e) {
      return e is map && e.keys().hasAll(['done','weight'])
        && e.keys().hasOnly(['done','weight']) && e.done is bool
        && e.weight is string && e.weight.size() <= 16
        && (e.weight == '' || (e.weight.matches('^[0-9]+([.][0-9]+)?$')
          && float(e.weight) >= 0 && float(e.weight) <= 2000));
    }
    function validWorkout(d) {
      return d.keys().hasAll(['session','logged','exercises','updatedAt'])
        && d.keys().hasOnly(['session','logged','exercises','updatedAt'])
        && d.session is string && d.session.size() >= 1 && d.session.size() <= 64
        && d.session.matches('^[a-zA-Z0-9-]+$') && d.logged is bool
        && d.updatedAt is timestamp && d.updatedAt == request.time
        && d.exercises is list && d.exercises.size() == 12
        && validExercise(d.exercises[0]) && validExercise(d.exercises[1])
        && validExercise(d.exercises[2]) && validExercise(d.exercises[3])
        && validExercise(d.exercises[4]) && validExercise(d.exercises[5])
        && validExercise(d.exercises[6]) && validExercise(d.exercises[7])
        && validExercise(d.exercises[8]) && validExercise(d.exercises[9])
        && validExercise(d.exercises[10]) && validExercise(d.exercises[11]);
    }
    function validHistory(d) {
      return d.keys().hasAll(['day','at']) && d.keys().hasOnly(['day','at'])
        && d.day is int && d.day >= 0 && d.day <= 3
        && d.at is timestamp && d.at <= request.time + duration.value(5,'m');
    }
    match /users/{uid}/workouts/{day} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && day.matches('^[0-3]$')
        && validWorkout(request.resource.data);
    }
    match /users/{uid}/history/{session} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && session.size() <= 64
        && validHistory(request.resource.data);
      allow update: if isOwner(uid) && validHistory(request.resource.data)
        && request.resource.data == resource.data;
    }

    // Active workout sessions: owner-only, bounded records.
    match /users/{uid}/sessions/{sessionId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && sessionId.size() <= 64
        && request.resource.data.keys().hasAll(['id','day','status','startedAt','sets','restSeconds','updatedAt'])
        && request.resource.data.id == sessionId
        && request.resource.data.day is int
        && request.resource.data.day >= 0 && request.resource.data.day <= 3
        && request.resource.data.status in ['active','completed']
        && request.resource.data.sets is list
        && request.resource.data.sets.size() == 12
        && request.resource.data.startedAt is string
        && request.resource.data.startedAt.size() <= 32
        && request.resource.data.keys().hasOnly(['id','day','status','startedAt','endedAt','durationSeconds','restSeconds','restUntil','sets','updatedAt'])
        && request.resource.data.restSeconds is int
        && request.resource.data.restSeconds >= 0 && request.resource.data.restSeconds <= 600
        && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/users/$(uid)/sessions/$(sessionId))
          || resource.data.status == 'active' && request.resource.data.startedAt == resource.data.startedAt && request.resource.data.day == resource.data.day);
    }
    match /users/{uid}/sessionControl/{controlId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && controlId == 'active'
        && request.resource.data.keys().hasOnly(['sessionId','updatedAt'])
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 64
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
